# Template for apps/web/.env.local — copy this file to .env.local and fill in real values.
# .env.local is git-ignored; .env.example is committed as documentation.

# Clerk authentication keys. Get from https://dashboard.clerk.com/
# pk_test_* / sk_test_* during development; pk_live_* / sk_live_* in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Where Clerk should redirect users on auth events.
# fallbackRedirectUrl is used when there's no specific intended destination
# (e.g. user signed in from the navbar, not from a protected route).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk webhook secret — get from Clerk Dashboard → Webhooks → signing secret.
# Used to verify that incoming webhook calls are genuinely from Clerk (not spoofed).
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Neon Postgres connection string — same value as packages/db/.env DATABASE_URL.
# Needed here so the Next.js server can reach the DB when handling webhook upserts.
DATABASE_URL=postgresql://REPLACE_ME
