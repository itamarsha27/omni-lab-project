# Copy to .env and fill in real values. Never commit .env.

# Port the server listens on (Fly.io expects 8080 by default)
PORT=8080

# Upstash Redis — ioredis protocol (NOT the REST URL)
# Format: rediss://:<password>@<host>.upstash.io:6380
REDIS_URL=rediss://:your-password@your-host.upstash.io:6380

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000
