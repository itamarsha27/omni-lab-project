# Template for packages/db/.env — copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed so other developers know what to provide.

# Neon Postgres connection string. Get from https://console.neon.tech/
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
